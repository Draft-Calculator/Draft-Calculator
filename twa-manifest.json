{
  "packageId": "com.markjun.quickdraft",
  "host": "draft-calculator.github.io",
  "name": "Quick Draft Calculator",
  "launcherName": "QuickDraft",
  "display": "standalone",
  "themeColor": "#0f1722",
  "navigationColor": "#0f1722",
  "backgroundColor": "#0f1722",
  "enableNotifications": false,
  "startUrl": "/Draft-Calculator/index.html",
  "iconUrl": "https://draft-calculator.github.io/Draft-Calculator/icon-512.png",
  "maskableIconUrl": "https://draft-calculator.github.io/Draft-Calculator/icon-maskable-512.png",
  "webManifestUrl": "https://draft-calculator.github.io/Draft-Calculator/manifest.webmanifest",
  "fullScopeUrl": "https://draft-calculator.github.io/Draft-Calculator/",
  "appVersion": "2.0.0",
  "appVersionCode": 2,
  "features": {
    "playBilling": {
      "enabled": true
    }
  },
  "orientation": "default",
  "fallbackType": "customtabs",
  "signingKey": {
    "path": "./android.keystore",
    "alias": "quickdraft"
  },
  "generatorApp": "bubblewrap-cli",
  "enableSiteSettingsShortcut": true,
  "isChromeOSOnly": false,
  "isMetaQuest": false,
  "splashScreenFadeOutDuration": 300,
  "shortcuts": [],
  "minSdkVersion": 21
}